# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/magazin_pos?schema=public"

# JWT Authentication (production: 32+ chars, random secrets)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
NODE_ENV="development"
PORT=3001
API_PREFIX="/api/v1"
CORS_ORIGIN="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"

# Production options
# TRUST_PROXY="true"          # Reverse proxy артында
# SERVE_FRONTEND="true"       # Backend frontend/dist тейлейт
# FRONTEND_DIST="../frontend/dist"

# Seed (production: demo маалыматты өткөрүү үчүн)
# ALLOW_DEMO_SEED="true"

# Frontend (Vite) — dev: /api/v1 (Vite proxy), prod: толук URL
VITE_API_URL="/api/v1"

# Docker production (docker-compose.prod.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=strong-password-here
# POSTGRES_DB=magazin_pos
# APP_PORT=3001
